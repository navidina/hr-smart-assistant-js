{
  "name": "hr-smart-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HR Smart Assistant — Node.js + Express + SQLite backend with a static frontend.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:seed": "node server/load-sql.js",
    "employees:build-sql": "node tools/import-employees.mjs plist.xlsx seed-employees.sql",
    "employees:load": "node server/load-sql.js seed-employees.sql",
    "knowledge:build": "node tools/build-knowledge.mjs"
  },
  "devDependencies": {
    "mammoth": "^1.12.0",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.2"
  }
}
