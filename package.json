{
  "name": "smartassistant-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Pages frontend + TypeScript Functions backend for the HR Smart Assistant.",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute smartassistant --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute smartassistant --remote --file=./schema.sql",
    "employees:build-sql": "node tools/import-employees.mjs plist.xlsx seed-employees.sql",
    "employees:load:remote": "wrangler d1 execute smartassistant --remote --file=./seed-employees.sql",
    "knowledge:build": "node tools/build-knowledge.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "mammoth": "^1.12.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.95.0",
    "xlsx": "^0.18.5"
  }
}
