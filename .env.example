# Copy this file to .env and fill in the values.

# Port the server listens on.
PORT=3000

# Required: AvalAI (OpenAI-compatible) API key for the assistant.
AVALAI_API_KEY=
# AvalAI endpoint and model (defaults shown).
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_MODEL=gpt-4o-mini

# Required in production: random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Demo login credentials.
DEMO_USERNAME=admin
DEMO_PASSWORD=rayan@1404
# Optional: bind the demo session to a specific employee code.
DEMO_EMPLOYEE_CODE=

# Optional: where the SQLite database file is stored.
DATABASE_PATH=./data/smartassistant.db
